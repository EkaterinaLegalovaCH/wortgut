# Wortgut configuration — copy to .env and adjust if needed.
# None of these values are secrets; no API keys are used anywhere in the app.

# SQLite database file (created automatically on first start)
DATABASE_PATH=data/wortgut.sqlite3

# Directory for the one-time downloaded source data (dictionary + frequency list)
DATA_DIR=data

# Translation target language
TARGET_LANG=en

# Server bind address — localhost only until the deploy milestone
HOST=127.0.0.1
PORT=8000
